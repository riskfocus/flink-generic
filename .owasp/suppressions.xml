        <notes><![CDATA[ CVE-XXXX-YYYYY does not apply: <reason>. Reviewed <name> <date>. ]]></notes>
        <packageUrl regex="true">^pkg:maven/com\.example/some-artifact@.*$</packageUrl>
        <cve>CVE-XXXX-YYYYY</cve>
    </suppress>
    -->

</suppressions>
